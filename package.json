{
  "name": "trustant-installer-plugin",
  "private": true,
  "scripts": {
    "test": "bun test infinity && python3 -B -m unittest discover -s infinity -p 'test_*.py'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'infinity/*.ts' 'infinity/image/*.ts' 'infinity/*.md' 'infinity/*.yml' spec/infinity.md README.md opsfile.yml"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
